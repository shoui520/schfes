diff --git a/libopensles/VitaPcm.c b/libopensles/VitaPcm.c
new file mode 100644
index 0000000..7236018
--- /dev/null
+++ b/libopensles/VitaPcm.c
@@ -0,0 +1,115 @@
+#include "VitaPcm.h"
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+extern void vita_pcm_rate_trace(uint32_t,uint32_t,uint32_t) __attribute__((weak));
+void vita_pcm_destroy(VitaPcmState *state) {
+    if(state->resampler)speex_resampler_destroy(state->resampler);
+    memset(state,0,sizeof(*state));
+}
+void vita_pcm_reset(VitaPcmState *state) {
+    // Recreate on the next enqueue: this guarantees both channel histories
+    // and fractional positions are reset across Speex library versions.
+    vita_pcm_destroy(state);
+}
+int vita_pcm_convert(VitaPcmState *state,uint32_t input_millihz,uint32_t output_hz,
+    unsigned channels,unsigned bits,const void *source,uint32_t bytes,
+    const void **output,uint32_t *output_bytes,void **owned) {
+    *owned=NULL;*output=NULL;*output_bytes=0;
+    if(!source || !bytes || !input_millihz || !output_hz || output_hz>UINT32_MAX/1000 ||
+       (channels!=1 && channels!=2) || (bits!=8 && bits!=16))return -1;
+    unsigned frame_bytes=channels*(bits/8);
+    if(bytes%frame_bytes)return -1;
+    uint32_t frames=bytes/frame_bytes,output_millihz=output_hz*1000;
+    if(state->resampler && (state->input_millihz!=input_millihz || state->output_hz!=output_hz))
+        vita_pcm_destroy(state);
+    if(input_millihz==output_millihz && channels==2 && bits==16) {
+        *output=source;*output_bytes=bytes;return 0;
+    }
+    const int16_t *pcm=source;int16_t *normalized=NULL;
+    if(channels!=2 || bits!=16) {
+        if(frames>UINT32_MAX/4)return -1;
+        normalized=malloc((size_t)frames*4);
+        if(!normalized)return -2;
+        for(uint32_t f=0;f<frames;f++)for(unsigned c=0;c<2;c++) {
+            uint32_t index=f*channels+(channels==1?0:c);
+            int16_t value;
+            if(bits==8)value=((const uint8_t*)source)[index]*256-32768;
+            else memcpy(&value,(const uint8_t*)source+index*2,2);
+            normalized[f*2+c]=value;
+        }
+        pcm=normalized;
+    }
+    if(input_millihz==output_millihz) {
+        *owned=normalized;*output=normalized;*output_bytes=frames*4;return 0;
+    }
+    if(!state->resampler) {
+        int error;
+        state->resampler=speex_resampler_init_frac(2,input_millihz,output_millihz,
+            (input_millihz+500)/1000,output_hz,4,&error);
+        if(!state->resampler){free(normalized);return -2;}
+        state->input_millihz=input_millihz;state->output_hz=output_hz;
+        if(vita_pcm_rate_trace)vita_pcm_rate_trace(input_millihz,output_hz,
+            speex_resampler_get_output_latency(state->resampler));
+    }
+    // Preserve Speex's filter history and fractional phase across queue entries.
+    // Headroom covers the carried fractional output frame without truncating input.
+    uint64_t capacity=((uint64_t)frames*output_millihz+input_millihz-1)/input_millihz+64;
+    if(capacity>UINT32_MAX/4){free(normalized);return -1;}
+    int16_t *converted=malloc((size_t)capacity*4);
+    if(!converted){free(normalized);return -2;}
+    uint32_t offset=0,total=0;
+    int error=0;
+    // The Vita Speex PCM16 adapter uses stack scratch proportional to the
+    // requested output length. Bound each call for the game's 32 KB threads.
+    while(offset<frames) {
+        spx_uint32_t consumed=frames-offset>512?512:frames-offset;
+        spx_uint32_t produced=capacity-total>1024?1024:capacity-total;
+        if(!produced){error=-1;break;}
+        error=speex_resampler_process_interleaved_int(state->resampler,
+            pcm+offset*2,&consumed,converted+total*2,&produced);
+        if(error || (!consumed && !produced)){error=-1;break;}
+        offset+=consumed;total+=produced;
+    }
+    free(normalized);
+    if(error || offset!=frames){free(converted);return -3;}
+    *output=converted;*owned=converted;*output_bytes=total*4;
+    return 0;
+}
+
+int vita_pcm_render(VitaPcmState *state,uint32_t rate,uint32_t output_hz,unsigned channels,unsigned bits,
+    const void *src,uint32_t *in_bytes,int16_t *out,uint32_t *out_bytes) {
+    if(!src || !out || !rate || !output_hz || output_hz>UINT32_MAX/1000 ||
+       (channels!=1 && channels!=2) || (bits!=8 && bits!=16))return -1;
+    unsigned frame_bytes=channels*(bits/8);
+    if(*in_bytes%frame_bytes || *out_bytes<4)return -1;
+    uint32_t frames=*in_bytes/frame_bytes,capacity=*out_bytes/4;
+    if(frames>512)frames=512;if(capacity>1024)capacity=1024;
+    if(!frames){*in_bytes=*out_bytes=0;return 0;}
+    uint32_t output_rate=output_hz*1000;
+    if(state->resampler && (state->input_millihz!=rate || state->output_hz!=output_hz))vita_pcm_destroy(state);
+    if(rate==output_rate && frames>capacity)frames=capacity;
+    int16_t normalized[1024];const int16_t *pcm=src;
+    if(channels!=2 || bits!=16) {
+        for(uint32_t i=0;i<frames;i++)for(unsigned c=0;c<2;c++) {
+            uint32_t index=i*channels+(channels==1?0:c);int16_t value;
+            if(bits==8)value=((const uint8_t*)src)[index]*256-32768;
+            else memcpy(&value,(const uint8_t*)src+index*2,2);
+            normalized[i*2+c]=value;
+        }
+        pcm=normalized;
+    }
+    if(rate==output_rate) {
+        memcpy(out,pcm,frames*4);*in_bytes=frames*frame_bytes;*out_bytes=frames*4;return 0;
+    }
+    if(!state->resampler) {
+        int error;state->resampler=speex_resampler_init_frac(2,rate,output_rate,(rate+500)/1000,output_hz,4,&error);
+        if(!state->resampler)return -2;
+        state->input_millihz=rate;state->output_hz=output_hz;
+        if(vita_pcm_rate_trace)vita_pcm_rate_trace(rate,output_hz,speex_resampler_get_output_latency(state->resampler));
+    }
+    spx_uint32_t consumed=frames,produced=capacity;
+    int error=speex_resampler_process_interleaved_int(state->resampler,pcm,&consumed,out,&produced);
+    if(error || (!consumed && !produced))return -3;
+    *in_bytes=consumed*frame_bytes;*out_bytes=produced*4;return 0;
+}
