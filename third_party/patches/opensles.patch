+typedef struct {
+    SpeexResamplerState *resampler;
+    uint32_t input_millihz, output_hz;
+} VitaPcmState;
+// Output is stereo PCM16. Equal-rate stereo PCM16 can borrow the source;
+// otherwise owned receives an allocation to release after playback.
+int vita_pcm_convert(VitaPcmState *state,uint32_t input_millihz,uint32_t output_hz,
+    unsigned channels,unsigned bits,const void *source,uint32_t bytes,
+    const void **output,uint32_t *output_bytes,void **owned);
+void vita_pcm_reset(VitaPcmState *state);
+void vita_pcm_destroy(VitaPcmState *state);
+// Render a bounded portion of a queued source buffer without allocating a full
+// resampled copy. in_bytes/out_bytes report bytes consumed/produced.
+int vita_pcm_render(VitaPcmState *,uint32_t,uint32_t,unsigned,unsigned,
+    const void *,uint32_t *,int16_t *,uint32_t *);
